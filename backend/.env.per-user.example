# Environment Variables for Per-User Integration

# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/your_database

# Prokip API Configuration
PROKIP_BASE_URL=https://your-prokip-domain.com

# Security (CRITICAL - Generate secure values)
ENCRYPTION_SECRET=your-super-secure-32-character-encryption-key-here
WOOCOMMERCE_WEBHOOK_SECRET=your-woocommerce-webhook-secret-here

# Server Configuration
NODE_ENV=production
PORT=3000

# Development/Testing (Optional)
TEST_USER_ID=test-user-123

# Feature Flags
ENABLE_STOCK_CHECK=true
ENABLE_WEBHOOK_SIGNATURE_VERIFICATION=true

# Monitoring (Optional)
LOG_LEVEL=info
ENABLE_API_USAGE_TRACKING=true

# Rate Limiting (Optional)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
