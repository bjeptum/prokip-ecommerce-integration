# Prokip Connector Plugin Environment Configuration

# Server Configuration
PORT=3001
NODE_ENV=development

# Prokip API Configuration
PROKIP_API_URL=https://api.prokip.africa
PROKIP_API_KEY=your_prokip_api_key_here

# Security
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Logging
LOG_LEVEL=info
LOG_REQUESTS=true

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Sync Configuration
SYNC_BATCH_SIZE=50
SYNC_TIMEOUT_MS=30000
SYNC_RETRY_ATTEMPTS=3
SYNC_RETRY_DELAY_MS=2000

# Database (if needed for local caching)
# DATABASE_URL=postgresql://user:password@localhost:5432/prokip_connector

# Redis (if needed for job queue)
# REDIS_URL=redis://localhost:6379

# Webhook Configuration
WEBHOOK_SECRET=your_webhook_secret_here
WEBHOOK_TIMEOUT_MS=10000

# Feature Flags
ENABLE_SHOPIFY=true
ENABLE_WOOCOMMERCE=true
ENABLE_CUSTOM_PLATFORMS=true

# Monitoring
ENABLE_METRICS=true
METRICS_PORT=9090
